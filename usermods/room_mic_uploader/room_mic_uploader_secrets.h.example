#pragma once

// room_mic_uploader credentials — copy to room_mic_uploader_secrets.h (gitignored) and fill in.
//
// NP_DEVICE_TOKEN MUST be the SAME bearer token Board 2 uses: one appliance = one Device =
// one token. /ingest and /nowplaying are scoped per-Device, so a different token writes an
// empty tenant and Board 2 shows idle forever. (Eventually provisioned Board 2 -> Board 1
// over UART at onboarding; hardcoded here for now.)
//
// Host/port/path are split (not a URL) because the POST goes over a raw WiFiClient —
// WLED's build does not include the Arduino HTTPClient library.

#define NP_HOST         "192.168.1.163"     // cloud LAN IP (hand-run dev cloud)
#define NP_PORT         8000
#define NP_INGEST_PATH  "/api/ingest"
#define NP_DEVICE_TOKEN "<shared appliance device token>"
